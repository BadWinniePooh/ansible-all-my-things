# syntax=docker/dockerfile:1

# Self-contained web frontend image (webui/): serves the interface that
# drives this repository's Hetzner Cloud playbooks. Deliberately
# independent of .docker/Dockerfile (the ansible-runner image) — own base,
# own dependency set, own build. Neither FROMs, nor shares a tag with, the
# runner image (spec.md FR-002). See
# specs/017-hcloud-web-frontend/research.md section 1 for the base-image
# choice and section 2-3 for the reduced dependency sets.
#
# Build (from repo root):
#   docker build -t ansible-web -f .docker/Dockerfile.web .
#
# Two-stage build: builder compiles into a venv and installs the Galaxy
# collections; the runtime stage copies only those artifacts plus the
# repository checkout. pip, setuptools and wheel are stripped from the venv
# at the end of the builder stage, before the runtime COPY, so neither
# stage's final image carries a pip binary (structure-test asserted).

FROM python:3.13-slim-trixie AS builder

ENV DEBIAN_FRONTEND=noninteractive

# gcc/libffi-dev/python3-dev cover any dependency without a prebuilt wheel
# for this platform; discarded with the rest of the builder stage.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        libffi-dev \
        python3-dev

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements-web.txt /tmp/requirements-web.txt
RUN pip install --no-cache-dir -r /tmp/requirements-web.txt

COPY requirements-web.yml /tmp/requirements-web.yml
RUN ansible-galaxy collection install -r /tmp/requirements-web.yml

# Strip the package installer itself out of the venv that ships forward —
# nothing at runtime ever installs a package, and a pip binary in the
# final image is exactly the kind of out-of-scope tooling SC-007 checks
# for.
RUN pip uninstall -y pip setuptools wheel \
    && find /opt/venv -depth \
        \( -iname 'pip*' -o -iname 'setuptools*' -o -iname 'wheel*' \) \
        -exec rm -rf {} +


FROM python:3.13-slim-trixie

ENV DEBIAN_FRONTEND=noninteractive

# Runtime stays minimal: only what the web server and SSH-ing out to
# managed hosts need. No compilers, pip, or git.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        openssh-client \
    && find /usr/local/lib/python3.13 /usr/local/bin -depth \
        \( -iname 'pip*' -o -iname 'setuptools*' -o -iname 'wheel*' \) \
        -exec rm -rf {} + 2>/dev/null || true

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /root/.ansible /root/.ansible

ENV PATH="/opt/venv/bin:$PATH"
ENV ANSIBLE_CONFIG=/ansible/ansible.cfg

RUN mkdir -p /root/.ssh \
    && chmod 700 /root/.ssh

WORKDIR /ansible

# Whole repo, filtered by .docker/Dockerfile.web.dockerignore (no
# secrets, no docs, no VCS metadata, no AWS/Windows-only playbooks/roles —
# see research.md section 8 for BuildKit's per-Dockerfile ignore support).
COPY . /ansible

# Normalize line endings on executed scripts, same reasoning as the
# runner image: a Windows checkout (core.autocrlf) yields CRLF, which
# breaks the interpreter lookup inside the container.
RUN find /ansible -name '*.sh' -exec sed -i 's/\r$//' {} + \
    && chmod +x /ansible/webui/entrypoint.sh /ansible/scripts/*.sh

# A pristine snapshot of the volume's starting contents, used later to
# detect and refresh stale defaults after an image upgrade (research.md
# section 6, webui/seed.py). Same dockerignore filters this copy, so it
# never contains vault.yml, the autogenerated inventory, or known_hosts.
RUN cp -r /ansible/inventories /ansible/.inventories-pristine

# Declared after the repo COPY so changing it does not bust earlier cache
# layers.
ARG IMAGE_VERSION=dev
RUN echo "${IMAGE_VERSION}" > /ansible/VERSION

ENV WEBUI_HOST=0.0.0.0 \
    WEBUI_PORT=8080

EXPOSE 8080

ENTRYPOINT ["/ansible/webui/entrypoint.sh"]
