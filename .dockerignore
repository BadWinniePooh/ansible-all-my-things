# Build-context filter for .docker/Dockerfile (ansible-runner image).
# Keep only what ansible-playbook needs at runtime: ansible.cfg,
# inventories/group_vars, playbooks/, roles/, scripts/, configuration/,
# requirements files (consumed in the builder stage).

# VCS and tooling metadata
.git
.gitignore
.github
.beads
.omc
.rtk
.specify
.claude
.devcontainer

# Documentation and specs (not needed to execute playbooks)
docs
specs
role-template
**/*.md
.markdownlint.json
.shellcheckrc

# Docker build files themselves (entrypoint.sh must stay in-image)
.docker/Dockerfile
.docker/tests.yaml

# Secrets — never baked into the image; host-mounted at runtime
**/vault.yml
.envrc

# Local state — lives in the host-mounted inventories directory
inventories/*_autogenerated.yml
inventories/*_known_hosts*

# VERSION is written at build time via the IMAGE_VERSION build arg;
# a stray host copy must not override it
VERSION

# Local artifacts and caches
container-structure-test-linux-arm64
lancedb
.venv
__pycache__/
**/*.pyc
.DS_Store
